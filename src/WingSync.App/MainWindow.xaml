<Window x:Class="WingSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="WingSync"
        Width="1240"
        Height="800"
        MinWidth="860"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        automation:AutomationProperties.AutomationId="MainWindow">
    <Window.Resources>
        <Style x:Key="LightNavButton" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="9,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                <Setter TargetName="NavChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BannerLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="WingPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource WingYellowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnWingYellowBrush}" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="15,9" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="68"
                        Height="68"
                        Background="#252525"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True"
                        automation:AutomationProperties.Name="WingSync-logo">
                    <Image Source="/WingSync;component/Assets/wingsync-logo.png"
                           Stretch="UniformToFill"
                           automation:AutomationProperties.AutomationId="WingSyncLogo"
                           automation:AutomationProperties.Name="WingSync logo, WING in white and SYNC in yellow" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WING"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="19"
                                   FontWeight="Bold" />
                        <TextBlock Text="SYNC"
                                   Foreground="{StaticResource WingYellowBrush}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Margin="5,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="FOH / MONITOR LINK"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="4"
                        Background="{StaticResource RaisedSurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,7"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONSOLEFLOW" Style="{StaticResource BannerLabel}" />
                            <TextBlock Text="{Binding DirectionSummaryText}"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       automation:AutomationProperties.AutomationId="DirectionSummaryText"
                                       automation:AutomationProperties.Name="{Binding DirectionSummaryText}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource LineBrush}" Margin="11,0" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="SESSION STATUS" Style="{StaticResource BannerLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding OverallStatusBrush}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OverallStatusText}"
                                           automation:AutomationProperties.AutomationId="OverallStatusText"
                                           automation:AutomationProperties.LiveSetting="Polite"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{StaticResource LineBrush}" Margin="11,0" />
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="MODE" Style="{StaticResource BannerLabel}" />
                            <Border Background="{Binding RunModeBackground}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="0,1,0,0">
                                <TextBlock Text="{Binding RunModeText}"
                                           Foreground="{Binding RunModeForeground}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           automation:AutomationProperties.AutomationId="RunModeText"
                                           automation:AutomationProperties.Name="{Binding RunModeText}"
                                           automation:AutomationProperties.LiveSetting="Assertive" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Grid.Column="6"
                        Content="Stop"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="76"
                        Padding="14,9"
                        VerticalAlignment="Center"
                        ToolTip="Emergency stop (Ctrl+Shift+S)"
                        automation:AutomationProperties.AutomationId="StopButton"
                        automation:AutomationProperties.Name="Immediately block new synchronization writes"
                        automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+S"
                        automation:AutomationProperties.HelpText="Immediately blocks new writes; an already-sent transaction is safely read back first and then both connections are disconnected. Shortcut Ctrl+Shift+S." />
                <Button Grid.Column="8"
                        Content="{Binding StartButtonText}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanPrimaryAction}"
                        Style="{StaticResource WingPrimaryButton}"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.AutomationId="StartButton"
                        automation:AutomationProperties.Name="{Binding StartButtonText}"
                        automation:AutomationProperties.HelpText="{Binding StartButtonHelpText}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource RaisedSurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                automation:AutomationProperties.AutomationId="WorkflowTimeline">
            <Grid Margin="20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SAFE WORKFLOW"
                               Style="{StaticResource BannerLabel}" />
                    <TextBlock Text="Follow each stage in order"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding WorkflowSteps}"
                              automation:AutomationProperties.AutomationId="WorkflowSteps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,6,0">
                                <Border Height="2"
                                        Margin="50,0,-12,21"
                                        VerticalAlignment="Center"
                                        Background="{Binding Connector}"
                                        Visibility="{Binding ConnectorVisibility}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding Foreground}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Marker}"
                                                   Foreground="{Binding Foreground}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                                   automation:AutomationProperties.Name="{Binding Status}" />
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Foreground}"
                                                   FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Width="188"
                HorizontalAlignment="Left"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="WORKSPACE"
                           Style="{StaticResource BannerLabel}"
                           Margin="23,20,0,8" />

                <ListBox Grid.Row="1"
                         SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         automation:AutomationProperties.AutomationId="Navigation">
                    <ListBoxItem Style="{StaticResource LightNavButton}"
                                 ToolTip="Status (Ctrl+1)"
                                 automation:AutomationProperties.AutomationId="NavigationStatus"
                                 automation:AutomationProperties.Name="Status"
                                 automation:AutomationProperties.AcceleratorKey="Ctrl+1"
                                 automation:AutomationProperties.HelpText="Open the live overview. Shortcut Ctrl+1.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x25CF;" Foreground="{StaticResource WingYellowBrush}" Margin="0,0,11,0" />
                            <TextBlock Text="Status" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource LightNavButton}"
                                 ToolTip="Synchronization (Ctrl+2)"
                                 automation:AutomationProperties.AutomationId="NavigationSync"
                                 automation:AutomationProperties.Name="Synchronization"
                                 automation:AutomationProperties.AcceleratorKey="Ctrl+2"
                                 automation:AutomationProperties.HelpText="Configure consoles, scopes, and channel mapping. Shortcut Ctrl+2.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2194;" Foreground="{StaticResource WingYellowBrush}" FontSize="18" Margin="0,-2,10,0" />
                            <TextBlock Text="Synchronization" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource LightNavButton}"
                                 ToolTip="Activity (Ctrl+3)"
                                 automation:AutomationProperties.AutomationId="NavigationActivity"
                                 automation:AutomationProperties.Name="Activity"
                                 automation:AutomationProperties.AcceleratorKey="Ctrl+3"
                                 automation:AutomationProperties.HelpText="View writes, reconnects, and problems. Shortcut Ctrl+3.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2261;" Foreground="{StaticResource WingYellowBrush}" FontSize="19" Margin="0,-3,11,0" />
                            <TextBlock Text="Activity" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource LightNavButton}"
                                 ToolTip="Settings (Ctrl+4)"
                                 automation:AutomationProperties.AutomationId="NavigationSettings"
                                 automation:AutomationProperties.Name="Settings"
                                 automation:AutomationProperties.AcceleratorKey="Ctrl+4"
                                 automation:AutomationProperties.HelpText="Open recovery, cache, and product information. Shortcut Ctrl+4.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" Foreground="{StaticResource WingYellowBrush}" FontSize="16" Margin="0,-1,10,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Row="2"
                        Margin="10,10,10,14"
                        Padding="11"
                        Background="{StaticResource RaisedSurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="LIVE AUDIO SAFETY"
                                   Style="{StaticResource BannerLabel}" />
                        <TextBlock Text="Dry run and readback first"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VersionText}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="188,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Margin="28,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}"
                               automation:AutomationProperties.AutomationId="HeaderTitleText"
                               FontWeight="SemiBold"
                               FontSize="17" />
                    <TextBlock Text="{Binding HeaderSubtitle}"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="11" />
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                        Background="{StaticResource CanvasBrush}"
                        BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,27,30,36" MaxWidth="1150">
                            <TextBlock Text="System status" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Live overview of both consoles, the cache, and the synchronization flow."
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="0,0,0,22" />

                            <Border Style="{StaticResource Card}"
                                    Background="{StaticResource WarningSurfaceBrush}"
                                    BorderBrush="{StaticResource WarningBorderBrush}"
                                    Margin="0,0,0,18"
                                    Visibility="{Binding HasBlockingProblems, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.AutomationId="ProblemBanner">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="31" Height="31" CornerRadius="16" Background="{StaticResource WarningBrush}">
                                        <TextBlock Text="!" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding PrimaryProblemTitle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PrimaryProblemDetail}"
                                                   automation:AutomationProperties.LiveSetting="Assertive"
                                                   Foreground="{StaticResource WarningTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="View"
                                            Command="{Binding ShowProblemsCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Background="{StaticResource RaisedSurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    Margin="0,0,0,18"
                                    automation:AutomationProperties.AutomationId="SetupChecklist">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="{Binding SetupProgressBackground}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SetupProgressIndicatorText}"
                                                   Foreground="{Binding SetupProgressForeground}"
                                                   FontWeight="Bold"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   automation:AutomationProperties.AutomationId="SetupProgressIndicator"
                                                   automation:AutomationProperties.Name="{Binding SetupProgressAccessibleText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding SetupProgressText}"
                                                   FontWeight="SemiBold"
                                                   automation:AutomationProperties.AutomationId="SetupProgressText" />
                                        <TextBlock Text="{Binding NextStepText}"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   automation:AutomationProperties.AutomationId="NextStepText" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open setup"
                                            Command="{Binding OpenSetupCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center"
                                            automation:AutomationProperties.AutomationId="OpenSetupButton"
                                            automation:AutomationProperties.Name="Open setup"
                                            automation:AutomationProperties.HelpText="Opens console selection, connection test, scopes, and channel mapping." />
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FohRoleCaption}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                                <TextBlock Text="{Binding FohName}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding FohStatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="9,4"
                                                    VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding FohStatusText}"
                                                               automation:AutomationProperties.AutomationId="FohStatusText"
                                                           Foreground="{Binding FohStatusForeground}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                        <Separator Margin="0,16,0,13" Background="{StaticResource LineBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="IP address" Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FohIp}" FontFamily="Consolas" />
                                            <TextBlock Grid.Row="1" Text="Model" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FohModel}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="2" Text="Firmware" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FohFirmware}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="3" Text="Last data" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Text="{Binding FohLastSeen}"
                                                       Margin="0,7,0,0"
                                                       automation:AutomationProperties.AutomationId="FohLastDataText" />
                                            <TextBlock Grid.Row="4" Text="Serial number" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Text="{Binding FohSerial}"
                                                       FontFamily="Consolas"
                                                       Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FohSerial}"
                                                       automation:AutomationProperties.AutomationId="FohSerialText" />
                                            <TextBlock Grid.Row="5" Text="Identity" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="5"
                                                       Grid.Column="1"
                                                       Text="{Binding FohIdentityText}"
                                                       Margin="0,7,0,0"
                                                       TextWrapping="Wrap"
                                                       automation:AutomationProperties.AutomationId="FohIdentityText" />
                                            <TextBlock Grid.Row="6" Text="Local cache" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="6"
                                                       Grid.Column="1"
                                                       Text="{Binding FohCacheSummary}"
                                                       Margin="0,7,0,0"
                                                       TextWrapping="Wrap"
                                                       automation:AutomationProperties.AutomationId="FohCacheSummaryText" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding FlowArrowText}"
                                               FontFamily="Consolas"
                                               FontSize="24"
                                               Foreground="{Binding FlowBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FlowStatusText}"
                                               automation:AutomationProperties.AutomationId="FlowStatusText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding FlowBrush}"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding StageRoleCaption}"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                                <TextBlock Text="{Binding StageName}"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding StageStatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="9,4"
                                                    VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StageStatusText}"
                                                               automation:AutomationProperties.AutomationId="StageStatusText"
                                                           Foreground="{Binding StageStatusForeground}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                        <Separator Margin="0,16,0,13" Background="{StaticResource LineBrush}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="IP address" Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding StageIp}" FontFamily="Consolas" />
                                            <TextBlock Grid.Row="1" Text="Model" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StageModel}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="2" Text="Firmware" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StageFirmware}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="3" Text="Last data" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Text="{Binding StageLastSeen}"
                                                       Margin="0,7,0,0"
                                                       automation:AutomationProperties.AutomationId="StageLastDataText" />
                                            <TextBlock Grid.Row="4" Text="Serial number" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Text="{Binding StageSerial}"
                                                       FontFamily="Consolas"
                                                       Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StageSerial}"
                                                       automation:AutomationProperties.AutomationId="StageSerialText" />
                                            <TextBlock Grid.Row="5" Text="Identity" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="5"
                                                       Grid.Column="1"
                                                       Text="{Binding StageIdentityText}"
                                                       Margin="0,7,0,0"
                                                       TextWrapping="Wrap"
                                                       automation:AutomationProperties.AutomationId="StageIdentityText" />
                                            <TextBlock Grid.Row="6" Text="Local cache" Foreground="{StaticResource MutedInkBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="6"
                                                       Grid.Column="1"
                                                       Text="{Binding StageCacheSummary}"
                                                       Margin="0,7,0,0"
                                                       TextWrapping="Wrap"
                                                       automation:AutomationProperties.AutomationId="StageCacheSummaryText" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,6,6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Verified live writes" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SyncedCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"
                                                   automation:AutomationProperties.AutomationId="VerifiedWritesText" />
                                        <TextBlock Text="written and read back" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="3,0,3,6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Preview / planned" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding PreviewedCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"
                                                   automation:AutomationProperties.AutomationId="PreviewedWritesText" />
                                        <TextBlock Text="no console write" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0,0,6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Blocked by safety" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding BlockedCount}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"
                                                   automation:AutomationProperties.AutomationId="BlockedWritesText" />
                                        <TextBlock Text="not executed" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,3,6,0" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Queue" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding QueueDepth}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="changes" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="3,3,3,0" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Latency p95" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding P95Latency}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="recent verified writes" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,3,0,0" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Local cache" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding CacheStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding CacheAge}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,27,30,40"
                                    MaxWidth="1150"
                                    IsEnabled="{Binding IsEditorEnabled}">
                            <TextBlock Text="Synchronization" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Choose the consoles, WING scopes, and the channel mapping. This configuration is locked during an active session."
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="0,0,0,22" />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FohEditorCaption}" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Discovered console" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                            <ComboBox ItemsSource="{Binding DiscoveredWings}"
                                                      SelectedItem="{Binding SelectedFohWing}"
                                                      Margin="0,4,0,10"
                                                      automation:AutomationProperties.AutomationId="FohConsoleCombo"
                                                      automation:AutomationProperties.Name="{Binding SelectedFohWing.DisplayName}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   automation:AutomationProperties.Name="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="IP address" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                            <TextBox Text="{Binding EditableFohIp, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,4,0,0"
                                                     automation:AutomationProperties.AutomationId="FohIpTextBox"
                                                     automation:AutomationProperties.Name="FOH IP address" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding StageEditorCaption}" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Discovered console" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                            <ComboBox ItemsSource="{Binding DiscoveredWings}"
                                                      SelectedItem="{Binding SelectedStageWing}"
                                                      Margin="0,4,0,10"
                                                      automation:AutomationProperties.AutomationId="StageConsoleCombo"
                                                      automation:AutomationProperties.Name="{Binding SelectedStageWing.DisplayName}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   automation:AutomationProperties.Name="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="IP address" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                            <TextBox Text="{Binding EditableStageIp, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,4,0,0"
                                                     automation:AutomationProperties.AutomationId="StageIpTextBox"
                                                     automation:AutomationProperties.Name="Stage IP address" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="Find consoles"
                                                Command="{Binding DiscoverCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                automation:AutomationProperties.AutomationId="DiscoverButton" />
                                        <Button Content="Test connection"
                                                Command="{Binding TestConnectionsCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                automation:AutomationProperties.AutomationId="TestConnectionsButton" />
                                        <TextBlock Text="{Binding DiscoveryStatus}"
                                                   automation:AutomationProperties.AutomationId="DiscoveryStatusText"
                                                   automation:AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="WING Library Scopes" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Only selected sections are tracked. Risky scopes are off by default."
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <ItemsControl ItemsSource="{Binding ScopeSelections}"
                                                      automation:AutomationProperties.AutomationId="ScopeList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                     <CheckBox IsChecked="{Binding IsSelected}"
                                                               IsEnabled="{Binding IsSupported}"
                                                               ToolTip="{Binding Description}"
                                                               automation:AutomationProperties.AutomationId="{Binding AutomationId}"
                                                               automation:AutomationProperties.Name="{Binding DisplayName}"
                                                               automation:AutomationProperties.HelpText="{Binding Description}"
                                                               Margin="0,6,12,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding RiskLabel}"
                                                                       Foreground="{Binding RiskBrush}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Direction and safety" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Synchronization direction" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                        <ComboBox ItemsSource="{Binding DirectionOptions}"
                                                  SelectedItem="{Binding SelectedDirection}"
                                                  Margin="0,4,0,15"
                                                  automation:AutomationProperties.AutomationId="DirectionCombo"
                                                  automation:AutomationProperties.Name="Synchronization direction" />
                                        <CheckBox IsChecked="{Binding IsDryRun}"
                                                  IsEnabled="{Binding CanSelectLiveMode}"
                                                  automation:AutomationProperties.AutomationId="DryRunCheckBox"
                                                  automation:AutomationProperties.Name="Dry run, no writes">
                                            <StackPanel>
                                                <TextBlock Text="Dry run (no writes)" FontWeight="SemiBold" />
                                                <TextBlock Text="Shows exactly what WingSync would change."
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding VerifyEveryWrite}"
                                                  IsEnabled="False"
                                                  Margin="0,10,0,0"
                                                  automation:AutomationProperties.AutomationId="VerifyReadbackCheckBox"
                                                  automation:AutomationProperties.Name="Every write requires readback">
                                            <StackPanel>
                                                <TextBlock Text="Read back every write" FontWeight="SemiBold" />
                                                <TextBlock Text="Always active; this cannot be turned off."
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding AllowHighRiskWrites}"
                                                  IsEnabled="{Binding CanArmHighRisk}"
                                                  Margin="0,10,0,0"
                                                  automation:AutomationProperties.AutomationId="AllowHighRiskWritesCheckBox"
                                                  automation:AutomationProperties.Name="Allow high-risk scopes">
                                            <StackPanel>
                                                <TextBlock Text="Allow high-risk scopes"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Only after connection test and dry run; unlocks routing, BUS, MAIN, FADER, and MUTE with extra confirmation."
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedInkBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                        <Border Background="{StaticResource InfoSurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                                            <TextBlock Text="{Binding SafetySummary}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource InfoTextBrush}"
                                                       FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding ConfigurationSafetyNotice}"
                                                   Foreground="{StaticResource WarningTextBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Margin="0,10,0,0"
                                                   automation:AutomationProperties.AutomationId="ConfigurationSafetyNoticeText"
                                                   automation:AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Channel mapping" Style="{StaticResource SectionTitle}" Margin="0" />
                                            <TextBlock Text="Input channels 1–40 and AUX channels 1–8 are mapped as separate series."
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Fill 1 → 1"
                                                    Command="{Binding AutoMapCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    automation:AutomationProperties.AutomationId="AutoMapButton" />
                                            <Button Content="Add row"
                                                    Command="{Binding AddMappingCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0"
                                                    automation:AutomationProperties.AutomationId="AddMappingButton" />
                                            <Button Content="Add AUX"
                                                    Command="{Binding AddAuxMappingCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0"
                                                    automation:AutomationProperties.AutomationId="AddAuxMappingButton" />
                                            <Button Content="Remove selection"
                                                    Command="{Binding RemoveMappingsCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0"
                                                    automation:AutomationProperties.AutomationId="RemoveMappingButton" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding ChannelMappings}"
                                              SelectedItem="{Binding SelectedMapping}"
                                              SelectionMode="Single"
                                              MinHeight="240"
                                              MaxHeight="370"
                                              automation:AutomationProperties.AutomationId="MappingGrid">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="75" />
                                            <DataGridCheckBoxColumn Header="AUX" Binding="{Binding IsAux}" Width="60" />
                                            <DataGridTextColumn Header="Source channel" Binding="{Binding SourceChannelText, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="Target channel" Binding="{Binding TargetChannelText, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="Channel" Binding="{Binding Label}" IsReadOnly="True" Width="2*" />
                                            <DataGridTextColumn Header="Validation" Binding="{Binding ValidationText}" IsReadOnly="True" Width="2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ValidationSummary}"
                                                   automation:AutomationProperties.AutomationId="ValidationSummaryText"
                                                   automation:AutomationProperties.LiveSetting="Polite"
                                                   Foreground="{Binding ValidationBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="1"
                                                Content="Save configuration"
                                                Command="{Binding SaveConfigurationCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                automation:AutomationProperties.AutomationId="SaveConfigurationButton" />
                                    </Grid>
                                    <TextBlock Text="{Binding ValidationDetails}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               automation:AutomationProperties.AutomationId="ValidationDetailsText" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="30,27,30,32" MaxWidth="1150">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Activity and problems" Style="{StaticResource PageTitle}" />
                        <Grid Grid.Row="1" Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Every write, reconnect, and validation error is logged locally."
                                       Foreground="{StaticResource MutedInkBrush}"
                                       VerticalAlignment="Center" />
                             <ComboBox Grid.Column="1"
                                       ItemsSource="{Binding ActivityFilters}"
                                       SelectedItem="{Binding SelectedActivityFilter}"
                                       Width="145"
                                       Margin="0,0,8,0"
                                       automation:AutomationProperties.AutomationId="ActivityFilterCombo" />
                            <Button Grid.Column="2"
                                    Content="Clear log"
                                     Command="{Binding ClearActivityCommand}"
                                     Style="{StaticResource SecondaryButton}"
                                     Margin="0,0,8,0"
                                     automation:AutomationProperties.AutomationId="ClearActivityButton" />
                            <Button Grid.Column="3"
                                    Content="Export support bundle"
                                    Command="{Binding ExportSupportBundleCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    automation:AutomationProperties.AutomationId="ExportSupportButton" />
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <ListView ItemsSource="{Binding FilteredActivity}"
                                      BorderThickness="0"
                                      automation:AutomationProperties.AutomationId="ActivityList">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Time" DisplayMemberBinding="{Binding TimeText}" Width="90" />
                                        <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="90" />
                                        <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="115" />
                                        <GridViewColumn Header="Event" DisplayMemberBinding="{Binding Message}" Width="500" />
                                        <GridViewColumn Header="Details" DisplayMemberBinding="{Binding Details}" Width="300" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,27,30,40" MaxWidth="900">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Behavior during startup, network loss, and local storage."
                                       Foreground="{StaticResource MutedInkBrush}"
                                       Margin="0,0,0,22" />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Recovery and network" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Automatically reconnect"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Enabled. Writes remain paused until both console identities have been re-confirmed and both states have been freshly read."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               Margin="0,4,0,12" />
                                    <TextBlock Text="Recovery delay: exponential, maximum 10 seconds." />
                                    <TextBlock Text="Event coalescing: 25 ms for fast knob movements."
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Local cache and logs" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Storage folder" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Margin="0,4,0,12"
                                             automation:AutomationProperties.AutomationId="DataDirectoryTextBox" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open folder"
                                                Command="{Binding OpenDataDirectoryCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                automation:AutomationProperties.AutomationId="OpenDataDirectoryButton" />
                                        <Button Content="Rebuild cache"
                                                Command="{Binding RebuildCacheCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                automation:AutomationProperties.AutomationId="RebuildCacheButton" />
                                    </StackPanel>
                                    <TextBlock Text="An outdated cache is never automatically written back to a WING."
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="11"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="About WingSync" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding FullVersionText}" />
                                        <TextBlock Text="Communication via x32ram/wapi; SLA included in the package."
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="Behringer and WING are trademarks of their respective owners."
                                                   Foreground="{StaticResource MutedInkBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Copy diagnostics"
                                            Command="{Binding CopyDiagnosticsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Top"
                                            automation:AutomationProperties.AutomationId="CopyDiagnosticsButton" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>
</Window>
