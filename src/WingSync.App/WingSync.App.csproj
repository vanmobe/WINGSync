<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WingSync.App</RootNamespace>
    <AssemblyName>WingSync</AssemblyName>
    <ApplicationIcon>Assets\WingSync.ico</ApplicationIcon>
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\WingSync.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WingSync.Core\WingSync.Core.csproj" />
    <ProjectReference Include="..\WingSync.Infrastructure\WingSync.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSES\wapi-SLA.pdf" Condition="Exists('..\..\LICENSES\wapi-SLA.pdf')">
      <Link>LICENSES\wapi-SLA.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
