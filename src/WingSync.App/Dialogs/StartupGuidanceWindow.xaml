<Window x:Class="WingSync.App.Dialogs.StartupGuidanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WingSync startup"
        Width="620"
        Height="580"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel>
                <TextBlock Text="Startup overview" Style="{StaticResource PageTitle}" />
                <TextBlock Text="WingSync loaded the workspace. Review what happened automatically and what still needs your action."
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18">
                <TextBlock Text="FOUND AND ASSIGNED" Style="{StaticResource DialogLabel}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="FOH" Foreground="{StaticResource WingYellowBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding FohName}" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding FohIp}" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding FohModel}" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding FohSerial}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="STAGE" Foreground="{StaticResource WingYellowBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" FontSize="16" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding StageIp}" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding StageModel}" Foreground="{StaticResource MutedInkBrush}" />
                            <TextBlock Text="{Binding StageSerial}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Button Content="Swap FOH and STAGE"
                        Command="{Binding SwapAssignmentsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,14"
                        AutomationProperties.AutomationId="StartupSwapAssignmentsButton" />

                <TextBlock Text="DONE AUTOMATICALLY" Style="{StaticResource DialogLabel}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding StartupIdentityCheckText}" Margin="0,3" />
                        <TextBlock Text="{Binding StartupConfigurationCheckText}" Margin="0,3" />
                    </StackPanel>
                </Border>

                <TextBlock Text="STILL REQUIRED" Style="{StaticResource DialogLabel}" Margin="0,14,0,8" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding StartupConnectionCheckText}" Margin="0,3" />
                        <TextBlock Text="{Binding StartupDryRunCheckText}" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource InfoSurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Discovered is not the same as connected"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StartupDiscoveryExplanation}"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="NEXT STEP" Style="{StaticResource DialogLabel}" Margin="0,16,0,5" />
                <TextBlock Text="{Binding NextStepText}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="View status"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        AutomationProperties.AutomationId="StartupViewStatusButton"
                        AutomationProperties.Name="Close the startup overview and view status"
                        Click="OnStayOnStatus" />
                <Button Content="Review and test connections"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="StartupOpenConnectionsButton"
                        AutomationProperties.Name="Open setup to review and test both console connections"
                        Click="OnOpenSetup" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
