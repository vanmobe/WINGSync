<Window x:Class="WingSync.App.Dialogs.MappingRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fill channel ranges" Width="560" Height="470"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Background="{StaticResource CanvasBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Fill input channel ranges" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1"
                   Text="Add one or more ranges. Each target range follows sequentially from its first target channel."
                   Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <DataGrid x:Name="RangesGrid" Grid.Row="2"
                  ItemsSource="{Binding RangeRows}"
                  SelectedItem="{Binding SelectedRangeRow}"
                  MinHeight="180" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Source from" Binding="{Binding SourceFrom}" Width="*" />
                <DataGridTextColumn Header="Source through" Binding="{Binding SourceThrough}" Width="*" />
                <DataGridTextColumn Header="Target starts at" Binding="{Binding TargetFrom}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add range" Style="{StaticResource SecondaryButton}" Click="OnAddRange" />
                <Button Content="Remove selected" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="OnRemoveRange" />
            </StackPanel>
            <TextBlock x:Name="ValidationMessage" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancel" />
            <Button Content="Fill ranges" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnFill" />
        </StackPanel>
    </Grid>
</Window>
