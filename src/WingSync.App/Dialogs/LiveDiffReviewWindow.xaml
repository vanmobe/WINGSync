<Window x:Class="WingSync.App.Dialogs.LiveDiffReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Verse live-preview bevestigen"
        Width="820"
        Height="680"
        MinWidth="560"
        MinHeight="420"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        automation:AutomationProperties.AutomationId="LiveDiffReviewDialog"
        automation:AutomationProperties.Name="Verse live-preview bevestigen">
    <Window.Resources>
        <Style x:Key="DialogPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E5C600" />
            <Setter Property="Foreground" Value="#121212" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FCFCFA"
                BorderBrush="#D7D7D1"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="#FFF2A8"
                        BorderBrush="#E4C400"
                        BorderThickness="1">
                    <TextBlock Text="!"
                               Foreground="#6C5A00"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Controleer de verse WING-diff"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Er wordt niets geschreven voordat je hieronder bewust bevestigt."
                               Foreground="{StaticResource MutedInkBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,22">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BRON"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding SourceSummary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       automation:AutomationProperties.AutomationId="LiveDiffSourceText" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="→"
                                   Foreground="#A58C00"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DOEL"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TargetSummary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       automation:AutomationProperties.AutomationId="LiveDiffTargetText" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Verse verschillen"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding TotalChanges}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="LiveDiffTotalCount" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="Uitvoerbaar na bevestiging"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding ExecutableChanges}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       automation:AutomationProperties.AutomationId="LiveDiffExecutableCount" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Door safety geblokkeerd"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding BlockedChanges}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       automation:AutomationProperties.AutomationId="LiveDiffBlockedCount" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Richting, scopes en mappings"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock Text="{Binding DirectionSummary}"
                                   Margin="0,7,0,0"
                                   automation:AutomationProperties.AutomationId="LiveDiffDirectionText" />
                        <TextBlock Text="{Binding EnabledScopesSummary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   automation:AutomationProperties.AutomationId="LiveDiffScopesText" />
                        <TextBlock Text="{Binding MappingSummary}"
                                   Margin="0,4,0,0"
                                   automation:AutomationProperties.AutomationId="LiveDiffMappingsText" />
                        <ItemsControl ItemsSource="{Binding ScopeCounts}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F2EE"
                                            BorderBrush="#D9DAD4"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9,4"
                                            Margin="0,0,6,6">
                                        <TextBlock>
                                            <Run Text="{Binding ScopeName}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ChangeCount}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding GeneratedAtSummary}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="HighRiskPanel"
                        Background="#FFF3E2"
                        BorderBrush="#D99A32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Verhoogd risico is gewapend"
                                   Foreground="#76531F"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   automation:AutomationProperties.AutomationId="LiveDiffHighRiskPanel" />
                        <TextBlock Text="MAIN, BUS, FADER, MUTE, routing of inserts kunnen direct hoorbaar wijzigen. Controleer dat beide shows veilig zijn opgeslagen."
                                   Foreground="#76531F"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,8" />
                        <CheckBox x:Name="HighRiskAcknowledgement"
                                  Content="Ik heb beide shows veilig opgeslagen en bevestig het verhoogde risico."
                                  Checked="OnHighRiskAcknowledgementChanged"
                                  Unchecked="OnHighRiskAcknowledgementChanged"
                                  automation:AutomationProperties.AutomationId="LiveDiffHighRiskAcknowledgement"
                                  automation:AutomationProperties.HelpText="Deze afzonderlijke bevestiging is verplicht voordat verhoogd-risicowrites kunnen starten." />
                    </StackPanel>
                </Border>

                <Expander Header="{Binding TokenListHeader}"
                          Background="White"
                          BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1"
                          Padding="12"
                          automation:AutomationProperties.AutomationId="LiveDiffTokenExpander"
                          automation:AutomationProperties.HelpText="Toont bron- en doeltokenpaden zonder parameterwaarden.">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding TokenListSummary}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Tokens}"
                                  IsReadOnly="True"
                                  MaxHeight="250"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  automation:AutomationProperties.AutomationId="LiveDiffTokenList">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Scope" Binding="{Binding ScopeName}" Width="90" />
                                <DataGridTextColumn Header="Bron-token" Binding="{Binding SourceToken}" Width="*" />
                                <DataGridTextColumn Header="Doel-token" Binding="{Binding TargetToken}" Width="*" />
                                <DataGridTextColumn Header="Safety" Binding="{Binding Disposition}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#FCFCFA"
                BorderBrush="#D7D7D1"
                BorderThickness="0,1,0,0"
                Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Standaardkeuze: annuleren · readback blijft verplicht"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Nee, annuleren"
                        IsCancel="True"
                        IsDefault="True"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        automation:AutomationProperties.AutomationId="7"
                        automation:AutomationProperties.Name="Nee"
                        automation:AutomationProperties.HelpText="Veilige standaardkeuze: sluit de preview zonder writes." />
                <Button x:Name="ApproveButton"
                        Grid.Column="2"
                        Content="Live activeren"
                        Click="OnApprove"
                        Style="{StaticResource DialogPrimaryButton}"
                        MinWidth="145"
                        automation:AutomationProperties.AutomationId="6"
                        automation:AutomationProperties.Name="Ja"
                        automation:AutomationProperties.HelpText="Voert na een laatste verse controle uitsluitend de toegestane wijzigingen uit." />
            </Grid>
        </Border>
    </Grid>
</Window>
