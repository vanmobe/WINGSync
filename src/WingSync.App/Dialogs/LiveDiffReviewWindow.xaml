<Window x:Class="WingSync.App.Dialogs.LiveDiffReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Confirm fresh live preview"
        Width="820"
        Height="680"
        MinWidth="560"
        MinHeight="420"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        automation:AutomationProperties.AutomationId="LiveDiffReviewDialog"
        automation:AutomationProperties.Name="Confirm fresh live preview">
    <Window.Resources>
        <Style x:Key="DialogPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource WingYellowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnWingYellowBrush}" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="{StaticResource SelectedBrush}"
                        BorderBrush="{StaticResource SelectedBorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="!"
                               Foreground="{StaticResource WingYellowBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Review the fresh WING diff"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Nothing is written until you deliberately confirm below."
                               Foreground="{StaticResource MutedInkBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,22">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SOURCE"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding SourceSummary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       automation:AutomationProperties.AutomationId="LiveDiffSourceText" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="→"
                                   Foreground="{StaticResource WingYellowBrush}"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TARGET"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TargetSummary}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       automation:AutomationProperties.AutomationId="LiveDiffTargetText" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Fresh differences"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding TotalChanges}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       automation:AutomationProperties.AutomationId="LiveDiffTotalCount" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="Executable after confirmation"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding ExecutableChanges}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       automation:AutomationProperties.AutomationId="LiveDiffExecutableCount" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Blocked by safety"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding BlockedChanges}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       automation:AutomationProperties.AutomationId="LiveDiffBlockedCount" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Direction, scopes, and mappings"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock Text="{Binding DirectionSummary}"
                                   Margin="0,7,0,0"
                                   automation:AutomationProperties.AutomationId="LiveDiffDirectionText" />
                        <TextBlock Text="{Binding EnabledScopesSummary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   automation:AutomationProperties.AutomationId="LiveDiffScopesText" />
                        <TextBlock Text="{Binding MappingSummary}"
                                   Margin="0,4,0,0"
                                   automation:AutomationProperties.AutomationId="LiveDiffMappingsText" />
                        <ItemsControl ItemsSource="{Binding ScopeCounts}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SubtleBrush}"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="9,4"
                                            Margin="0,0,6,6">
                                        <TextBlock>
                                            <Run Text="{Binding ScopeName}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ChangeCount}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding GeneratedAtSummary}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="HighRiskPanel"
                        Background="{StaticResource WarningSurfaceBrush}"
                        BorderBrush="{StaticResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="High risk is armed"
                                   Foreground="{StaticResource WarningTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   automation:AutomationProperties.AutomationId="LiveDiffHighRiskPanel" />
                        <TextBlock Text="MAIN, BUS, FADER, MUTE, routing, or inserts can change audibly right away. Verify that both shows are safely backed up."
                                   Foreground="{StaticResource WarningTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,8" />
                        <CheckBox x:Name="HighRiskAcknowledgement"
                                  Content="I have safely backed up both shows and confirm the high risk."
                                  Checked="OnHighRiskAcknowledgementChanged"
                                  Unchecked="OnHighRiskAcknowledgementChanged"
                                  automation:AutomationProperties.AutomationId="LiveDiffHighRiskAcknowledgement"
                                  automation:AutomationProperties.HelpText="This separate confirmation is required before high-risk writes can start." />
                    </StackPanel>
                </Border>

                <Expander Header="{Binding TokenListHeader}"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1"
                          Padding="12"
                          automation:AutomationProperties.AutomationId="LiveDiffTokenExpander"
                          automation:AutomationProperties.HelpText="Shows source and target token paths without parameter values.">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding TokenListSummary}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Tokens}"
                                  IsReadOnly="True"
                                  MaxHeight="250"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  automation:AutomationProperties.AutomationId="LiveDiffTokenList">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Scope" Binding="{Binding ScopeName}" Width="90" />
                                <DataGridTextColumn Header="Source token" Binding="{Binding SourceToken}" Width="*" />
                                <DataGridTextColumn Header="Target token" Binding="{Binding TargetToken}" Width="*" />
                                <DataGridTextColumn Header="Safety" Binding="{Binding Disposition}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Recommended after testing: start from now · no initial writes"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="No, cancel"
                        IsCancel="True"
                        IsDefault="True"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        automation:AutomationProperties.AutomationId="7"
                        automation:AutomationProperties.Name="No"
                        automation:AutomationProperties.HelpText="Safe default choice: close the preview without writes." />
                <Button x:Name="ApproveButton"
                        Grid.Column="2"
                        Content="Apply shown differences"
                        Click="OnApprove"
                        Style="{StaticResource DialogPrimaryButton}"
                        MinWidth="145"
                        automation:AutomationProperties.AutomationId="6"
                        automation:AutomationProperties.Name="Yes"
                        automation:AutomationProperties.HelpText="After one last fresh check, executes only the explicitly permitted differences." />
                <Button x:Name="StartFromNowButton"
                        Grid.Column="3"
                        Content="Start live from now"
                        Click="OnStartFromNow"
                        Style="{StaticResource DialogPrimaryButton}"
                        MinWidth="155"
                        Margin="8,0,0,0"
                        automation:AutomationProperties.AutomationId="StartLiveFromNowButton"
                        automation:AutomationProperties.Name="Start live from the current baseline without initial writes" />
            </Grid>
        </Border>
    </Grid>
</Window>
